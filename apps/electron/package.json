{
  "name": "@quar/electron",
  "version": "0.1.0",
  "private": true,
  "description": "Quar Animator desktop application (Electron)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && electron .",
    "build": "tsc -p tsconfig.build.json && electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist release"
  },
  "devDependencies": {
    "@quar/web": "workspace:*",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.quar.animator",
    "productName": "Quar Animator",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "identity": null
    },
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ]
  }
}
